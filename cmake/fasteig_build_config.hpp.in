#pragma once

// Private, generated build metadata consumed only by fasteig_version.cpp.
#define FASTEIG_BUILD_VERSION R"fasteig(@FASTEIG_BUILD_VERSION@)fasteig"
#define FASTEIG_BUILD_RELEASE_VERSION R"fasteig(@PROJECT_VERSION@)fasteig"
#define FASTEIG_BUILD_GIT_COMMIT R"fasteig(@FASTEIG_GIT_COMMIT@)fasteig"
#define FASTEIG_BUILD_GIT_DIRTY @FASTEIG_GIT_DIRTY@

#define FASTEIG_BUILD_SYSTEM "CMake"
#ifdef NDEBUG
#define FASTEIG_BUILD_TYPE "Release"
#else
#define FASTEIG_BUILD_TYPE "Debug"
#endif
#define FASTEIG_BUILD_CONFIGURE_OPTIONS R"fasteig(@FASTEIG_CMAKE_OPTIONS_TEXT@)fasteig"
#define FASTEIG_BUILD_CMAKE_VERSION R"fasteig(@CMAKE_VERSION@)fasteig"
#define FASTEIG_BUILD_CMAKE_GENERATOR R"fasteig(@CMAKE_GENERATOR@)fasteig"

#define FASTEIG_BUILD_CXX_COMPILER_ID R"fasteig(@CMAKE_CXX_COMPILER_ID@)fasteig"
#define FASTEIG_BUILD_CXX_COMPILER_VERSION R"fasteig(@CMAKE_CXX_COMPILER_VERSION@)fasteig"
#define FASTEIG_BUILD_CXX_COMPILER_PATH R"fasteig(@CMAKE_CXX_COMPILER@)fasteig"
#define FASTEIG_BUILD_CXX_FLAGS R"fasteig(@FASTEIG_CXX_FLAGS_TEXT@)fasteig"
#define FASTEIG_BUILD_CXX_STANDARD R"fasteig(@CMAKE_CXX_STANDARD@)fasteig"
#define FASTEIG_BUILD_PLATFORM R"fasteig(@PLAT@)fasteig"

#define FASTEIG_BUILD_USE_MKL @FASTEIG_BUILD_USE_MKL@
#define FASTEIG_BUILD_USE_LIBSCI @FASTEIG_BUILD_USE_LIBSCI@
#define FASTEIG_BUILD_ENABLE_CUDA @FASTEIG_BUILD_ENABLE_CUDA@
#define FASTEIG_BUILD_USE_CUDSS @FASTEIG_BUILD_USE_CUDSS@

#define FASTEIG_BUILD_CUDA_COMPILER R"fasteig(@FASTEIG_CUDA_COMPILER_TEXT@)fasteig"
#define FASTEIG_BUILD_CUDA_VERSION R"fasteig(@FASTEIG_CUDA_VERSION_TEXT@)fasteig"
#define FASTEIG_BUILD_CUDA_FLAGS R"fasteig(@FASTEIG_CUDA_FLAGS_TEXT@)fasteig"
#define FASTEIG_BUILD_CUDA_ARCHITECTURES R"fasteig(@FASTEIG_CUDA_ARCHITECTURES_TEXT@)fasteig"

