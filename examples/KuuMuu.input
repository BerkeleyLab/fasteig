#amatrix SiO.fei
amatrix ./Sparse_Matrices/Kuu.mtx
bmatrix ./Sparse_Matrices/Muu.mtx
logfile KuuMuu
output_format text

# 1 prints run header + final eigenpairs table
# 2 prints run header + per-iteration progress + final eigenpairs table
verbosity 2

# LOBPCG progress cadence (0 disables)
print_every 5
nev     5
which   LR
shift   100
solver  Lanczos
maxiter 5000
maxdim  40
blksize 10
degree  8
tol     1e-8
